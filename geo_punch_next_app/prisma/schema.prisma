generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model attendance_record {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id             String?           @db.Uuid
  latitude                Float
  longitude               Float
  selfie_url              String
  submitted_at            DateTime?         @default(now()) @db.Timestamp(6)
  status                  Int?              @default(1)
  address                 String?
  notes                   String?
  nearest_office_location String?           @db.Uuid
  distance                Float?
  employees               employees?        @relation(fields: [employee_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  office_locations        office_locations? @relation(fields: [nearest_office_location], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model departments {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  department_name String      @unique @db.VarChar(50)
  employees       employees[]
}

model designations {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  designations String      @unique @db.VarChar(50)
  employees    employees[]
}

model employees {
  id                String              @id(map: "employee_table_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_card_no        String?             @unique(map: "unique_id_card_no_per_user") @db.VarChar(50)
  name              String              @db.VarChar(75)
  department_id     String?             @db.Uuid
  designation_id    String?             @db.Uuid
  phone_no          String?             @db.VarChar(20)
  email             String?             @unique(map: "unique_email_per_user") @db.VarChar(50)
  is_active         Boolean?            @default(true)
  password          String?
  hashed_password   String?
  is_admin          Boolean?            @default(false)
  company_id        String?             @db.Uuid
  attendance_record attendance_record[]
  trusted_devices   trusted_devices[]
  departments       departments?        @relation(fields: [department_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "employee_table_department_id_fkey")
  designations      designations?       @relation(fields: [designation_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "employee_table_designation_id_fkey")
  company           company?            @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

enum device_trust_status {
  pending
  trusted
  rejected
}

model trusted_devices {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id     String              @db.Uuid
  credential_hash String              @db.Char(64)
  name            String              @db.VarChar(120)
  model           String?             @db.VarChar(120)
  platform        String?             @db.VarChar(20)
  os_version      String?             @db.VarChar(60)
  status          device_trust_status @default(pending)
  version         Int                 @default(1)
  requested_at    DateTime            @default(now()) @db.Timestamptz(6)
  reviewed_at     DateTime?           @db.Timestamptz(6)
  reviewed_by     String?             @db.Uuid
  last_sign_in_at DateTime?           @db.Timestamptz(6)
  employee        employees           @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employee_id, credential_hash])
  @@index([status, requested_at(sort: Desc)])
}

model company {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String      @db.VarChar(100)
  employees employees[]
  offices   offices[]
}

model offices {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @db.VarChar(100)
  company_id       String?            @db.Uuid
  office_locations office_locations[]
  company          company?           @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model office_locations {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  address           String?
  latitude          Float
  longitude         Float
  office_id         String?             @db.Uuid
  attendance_record attendance_record[]
  offices           offices?            @relation(fields: [office_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
