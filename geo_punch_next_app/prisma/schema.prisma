generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model attendance_record {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id  String?    @db.Uuid
  latitude     Float
  longitude    Float
  selfie_url   String
  submitted_at DateTime?  @default(now()) @db.Timestamp(6)
  status       Int?       @default(1)
  address      String?
  employees    employees? @relation(fields: [employee_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model departments {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  department_name String      @unique @db.VarChar(50)
  employees       employees[]
}

model designations {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  designations String      @unique @db.VarChar(50)
  employees    employees[]
}

model employees {
  id                String              @id(map: "employee_table_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_card_no        String?             @unique(map: "unique_id_card_no_per_user") @db.VarChar(50)
  name              String              @db.VarChar(75)
  department_id     String?             @db.Uuid
  designation_id    String?             @db.Uuid
  phone_no          String?             @db.VarChar(20)
  email             String?             @unique(map: "unique_email_per_user") @db.VarChar(50)
  is_active         Boolean?            @default(true)
  password          String?
  hashed_password   String?
  is_admin          Boolean?            @default(false)
  attendance_record attendance_record[]
  departments       departments?        @relation(fields: [department_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "employee_table_department_id_fkey")
  designations      designations?       @relation(fields: [designation_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "employee_table_designation_id_fkey")
}
